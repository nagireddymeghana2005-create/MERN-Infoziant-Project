MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/docconnect?retryWrites=true&w=majority
MONGODB_DB=docconnect
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
ADMIN_EMAIL=admin@docconnect.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# SMTP configuration for patient password reset messages.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=DOC-CONNECT <no-reply@example.com>
FRONTEND_URL=http://localhost:5173
